# ── Supabase (Settings → API) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Só no servidor: usado pelo webhook Shopify e pelo cron do Spy Engine (contorna RLS
# mas TODAS as queries filtram explicitamente por user_id / target_id).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── URL público da app (usado no redirect do login por e-mail) ───────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Shopify (Settings → Notifications → Webhooks → "Your webhooks will be signed with ...")
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cron (GitHub Actions envia "Authorization: Bearer $CRON_SECRET") ─────────
# Gera com: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# ── Telegram (fala com @BotFather para o token; @userinfobot para o chat id) ─
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
NEXT_PUBLIC_APP_TIMEZONE=Europe/Lisbon

# ── Meta Ad Library API (módulo Anúncios Meta) ───────────────────────────────
# Token de uma app Meta com identidade verificada: https://www.facebook.com/ads/library/api
META_ACCESS_TOKEN=
# Opcional: versão da Graph API e países da UE onde procurar anúncios (separados por vírgula)
META_GRAPH_VERSION=v23.0
META_AD_COUNTRIES=PT,ES,FR,DE,IT,NL,BE,IE,AT,PL,SE,DK,FI

# ── Trading Bots ─────────────────────────────────────────────────────────────
# Chave AES-256-GCM das API keys dos bots (64 hex). Gera com: openssl rand -hex 32
# NÃO alterar depois de guardar chaves: deixam de poder ser desencriptadas.
BOT_ENCRYPTION_KEY=
