# =============================================================================
# Zaynara OS — copia para .env.local (local) e replica em Vercel → Settings →
# Environment Variables. NUNCA faças commit do .env.local.
# Prefixo NEXT_PUBLIC_ = exposto ao browser. Tudo o resto é só servidor.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # em produção: https://zaynara-os.vercel.app
APP_TIMEZONE=Europe/Lisbon
DEFAULT_CURRENCY=EUR

# --- Módulo 1: Segurança ------------------------------------------------------
# Lista branca de emails com acesso (separados por vírgula). Segunda barreira
# para além de desligar "Allow new users to sign up" no Supabase Auth.
ALLOWED_EMAILS=tu@zaynara.pt

# --- Supabase (Project Settings → API Keys) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # (ou a "anon" legacy)
SUPABASE_SECRET_KEY=sb_secret_xxx                         # (ou a "service_role" legacy) — só cron/ingestão
SUPABASE_STORAGE_BUCKET=knowledge

# Google OAuth: configura Client ID/Secret no painel Supabase → Auth →
# Providers → Google (não precisam de estar aqui). Callback: <SITE_URL>/auth/callback

# --- Módulo 2: IA / RAG -------------------------------------------------------
GOOGLE_API_KEY=xxx                                  # Google AI Studio (free tier)
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768                     # TEM de bater com vector(768) no SQL
RAG_MATCH_COUNT=8
RAG_MIN_SIMILARITY=0.72                             # abaixo disto → "não encontrei nos teus documentos" + fallback web
TAVILY_API_KEY=tvly-xxx

# --- Módulo 3: Shopify Admin API ----------------------------------------------
SHOPIFY_STORE_DOMAIN=zaynara.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx                # scopes: read_orders, read_products, read_inventory, read_shopify_payments_payouts
SHOPIFY_API_VERSION=2026-10
LOW_STOCK_THRESHOLD=10

# Fallbacks determinísticos quando a Shopify não fornece o valor real:
GATEWAY_FEE_PERCENT=2.1                             # % por transação (gateways que não sejam Shopify Payments)
GATEWAY_FEE_FIXED=0.25                              # € fixos por transação
SHIPPING_COST_PER_ORDER=4.50                        # custo médio real de portes por encomenda (se não usares Shopify Shipping)

# --- Módulo 3: Meta Marketing API (Ads) ---------------------------------------
META_ACCESS_TOKEN=EAAxxx                            # token de System User (não expira), scope ads_read
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v24.0

# --- Módulo 4: Emails + Cron --------------------------------------------------
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Zaynara OS <alertas@zaynara.pt>" # sem domínio verificado: onboarding@resend.dev (só envia para o teu email)
ALERT_EMAIL_TO=tu@zaynara.pt
EXPENSE_ALERT_DAYS=3
CRON_SECRET=gera-com-openssl-rand-hex-32            # a Vercel envia "Authorization: Bearer $CRON_SECRET"
